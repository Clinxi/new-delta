# 复制为 .env 后修改。Node.js >=22.9，推荐 24 LTS。
PORT=3000
HOST=0.0.0.0
# 务必使用独立的长密码；留空则每次进程启动生成并仅在终端显示。
ADMIN_PASSWORD=
# 手机使用的服务器根网址，推荐公网 HTTPS；必须无路径和尾部斜杠。
# 局域网可填 http://192.168.1.20:3000；留空则自动选择本机局域网 IP。
PUBLIC_URL=
DATA_DIR=./data
MAX_PARTICIPANTS=1000
# 同一 IP 每分钟加入/修改次数。现场 Wi-Fi 的嘉宾常共享同一出口 IP。
JOIN_RATE_LIMIT=2000
# 仅在前方确有一层可信反向代理时设为 1（Secure cookie / 客户端 IP）。
TRUST_PROXY=0
